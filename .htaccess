# Vidnexa Studio – Apache settings (ignored by hosts that do not use Apache)
ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # one address only: www -> vidnexastudio.com (the host already forces https)
  RewriteCond %{HTTP_HOST} ^www\.vidnexastudio\.com$ [NC]
  RewriteRule ^(.*)$ https://vidnexastudio.com/$1 [L,R=301]
  # /folder/index.html -> /folder/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
</IfModule>
